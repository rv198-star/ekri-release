{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKRI v1.0 Derived Architecture View",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "knowledge_state": {
      "enum": ["observed-fact", "inferred-knowledge", "unknown", "conflicting"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "uniqueItems": true
    },
    "common_row_properties": {
      "id": {"type": "string", "minLength": 2},
      "knowledge_state": {"$ref": "#/$defs/knowledge_state"},
      "confidence": {"type": "string", "minLength": 2},
      "rationale": {"type": "string", "minLength": 2},
      "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
    },
    "architecture_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "knowledge_state",
        "confidence",
        "rationale",
        "evidence_refs",
        "name",
        "kind",
        "parent_id",
        "responsibility",
        "non_responsibilities"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "knowledge_state": {"$ref": "#/$defs/knowledge_state"},
        "confidence": {"type": "string", "minLength": 2},
        "rationale": {"type": "string", "minLength": 2},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "parent_id": {"type": ["string", "null"]},
        "responsibility": {"type": "string", "minLength": 1},
        "non_responsibilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "responsibility_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "knowledge_state",
        "confidence",
        "rationale",
        "evidence_refs",
        "subject",
        "owner",
        "responsibility",
        "non_responsibilities"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "knowledge_state": {"$ref": "#/$defs/knowledge_state"},
        "confidence": {"type": "string", "minLength": 2},
        "rationale": {"type": "string", "minLength": 2},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "subject": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "non_responsibilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "statement_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "knowledge_state",
        "confidence",
        "rationale",
        "evidence_refs",
        "subject",
        "statement"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "knowledge_state": {"$ref": "#/$defs/knowledge_state"},
        "confidence": {"type": "string", "minLength": 2},
        "rationale": {"type": "string", "minLength": 2},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "subject": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "assurance_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "knowledge_state",
        "confidence",
        "rationale",
        "evidence_refs",
        "subject",
        "owner",
        "responsibility"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "knowledge_state": {"$ref": "#/$defs/knowledge_state"},
        "confidence": {"type": "string", "minLength": 2},
        "rationale": {"type": "string", "minLength": 2},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "subject": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "authority_mode",
    "source",
    "provenance",
    "qualification_policy",
    "semantic_content",
    "summary",
    "semantic_fingerprint",
    "projection_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "ekri.architecture-view.v1"},
    "status": {"enum": ["derived-shadow-view", "source-baseline-view"]},
    "authority_mode": {
      "enum": ["derived-non-authoritative", "comparison-only-non-authoritative"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "source_commit",
        "source_tree",
        "snapshot_id",
        "architecture_memory_schema_version",
        "evidence_ref_count"
      ],
      "properties": {
        "profile_id": {"type": "string", "minLength": 2},
        "source_commit": {"type": "string", "minLength": 40},
        "source_tree": {"type": "string", "minLength": 40},
        "snapshot_id": {"type": "string", "minLength": 3},
        "architecture_memory_schema_version": {"type": "string", "minLength": 3},
        "evidence_ref_count": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation", "generator_version"],
      "properties": {
        "derivation": {"enum": ["direct-verified-phase1-baseline", "shadow-substrate"]},
        "generator_version": {"const": "ekri.architecture-view-generator.v0.1"},
        "shadow_authority_mode": {"const": "shadow-non-authoritative"},
        "shadow_semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "shadow_projection_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "qualification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_modality", "normative_posture"],
      "properties": {
        "semantic_modality": {"const": "source-preserved"},
        "normative_posture": {"const": "source-unspecified"}
      }
    },
    "semantic_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_architecture_tree",
        "module_responsibility_map",
        "implementation_intent_summary",
        "validation_assurance_ownership",
        "constraints",
        "unknowns",
        "claim_ceiling"
      ],
      "properties": {
        "system_architecture_tree": {
          "type": "array",
          "items": {"$ref": "#/$defs/architecture_row"}
        },
        "module_responsibility_map": {
          "type": "array",
          "items": {"$ref": "#/$defs/responsibility_row"}
        },
        "implementation_intent_summary": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement_row"}
        },
        "validation_assurance_ownership": {
          "type": "array",
          "items": {"$ref": "#/$defs/assurance_row"}
        },
        "constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement_row"}
        },
        "unknowns": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement_row"}
        },
        "claim_ceiling": {"type": "string", "minLength": 40}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_node_count",
        "responsibility_count",
        "implementation_intent_count",
        "assurance_count",
        "constraint_count",
        "unknown_count"
      ],
      "properties": {
        "architecture_node_count": {"type": "integer", "minimum": 0},
        "responsibility_count": {"type": "integer", "minimum": 0},
        "implementation_intent_count": {"type": "integer", "minimum": 0},
        "assurance_count": {"type": "integer", "minimum": 0},
        "constraint_count": {"type": "integer", "minimum": 0},
        "unknown_count": {"type": "integer", "minimum": 0}
      }
    },
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projection_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
