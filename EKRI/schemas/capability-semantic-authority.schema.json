{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKRI Capability Semantic Authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "authority_mode",
    "materialization_class",
    "source",
    "specification",
    "capability_count",
    "capabilities",
    "semantic_fingerprint",
    "projection_fingerprint",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "ekri.capability-semantic-authority.v1"},
    "status": {"const": "capability-semantic-authority-established"},
    "authority_mode": {"const": "ontology-authoritative"},
    "materialization_class": {"const": "reconstructable-semantic-authority"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "commit",
        "tree",
        "input_mode",
        "project_asset_id",
        "semantic_source_mode",
        "phase1_human_projection_sha256",
        "architecture_view_schema_version",
        "architecture_view_semantic_fingerprint",
        "architecture_view_projection_fingerprint"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 8},
        "commit": {"type": "string", "minLength": 40},
        "tree": {"type": "string", "minLength": 40},
        "input_mode": {"enum": ["provided-verified-view", "verified-local-phase1", "verified-project-asset"]},
        "project_asset_id": {"type": "string"},
        "semantic_source_mode": {"enum": ["architecture-view-plus-capability-spec", "verified-portable-capability-seed"]},
        "phase1_human_projection_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "architecture_view_schema_version": {"const": "ekri.architecture-view.v1"},
        "architecture_view_semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "architecture_view_projection_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "path", "sha256", "scanner_commit", "scanner_tree", "blob_oid"],
      "properties": {
        "source": {"type": "string"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scanner_commit": {"type": "string"},
        "scanner_tree": {"type": "string"},
        "blob_oid": {"type": "string"}
      }
    },
    "capability_count": {"type": "integer", "minimum": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "aliases", "existence", "knowledge_state", "confidence",
          "architecture_nodes", "responsibilities", "constraints", "implementation_intents",
          "assurance_ownership", "locations", "reuse_limitations", "mainline_impact", "evidence_refs"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "name": {"type": "string", "minLength": 2},
          "aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "existence": {"enum": ["confirmed-existing", "inferred-existing", "unknown"]},
          "knowledge_state": {"enum": ["observed-fact", "inferred-knowledge", "unknown", "conflicting"]},
          "confidence": {"enum": ["verified", "high", "medium", "low", "not-applicable"]},
          "architecture_nodes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "responsibilities": {"type": "array", "items": {"type": "object"}},
          "constraints": {"type": "array", "items": {"type": "object"}},
          "implementation_intents": {"type": "array", "items": {"type": "object"}},
          "assurance_ownership": {"type": "array", "items": {"type": "object"}},
          "locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reuse_limitations": {"type": "array", "items": {"type": "object"}},
          "mainline_impact": {"type": "object"},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
        }
      }
    },
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projection_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_ceiling": {"type": "string", "minLength": 80}
  }
}
