{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKRI Phase 3 Change Impact Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "status", "created_at", "source", "impact_count", "change_impacts", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "ekri.change-impact-map.v1"},
    "phase": {"const": "phase3-evolution-and-impact-intelligence"},
    "status": {"const": "change-impact-map-built"},
    "created_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_tree", "target_tree", "scan_id"],
      "properties": {
        "baseline_tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "target_tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        "scan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "impact_count": {"type": "integer", "minimum": 0},
    "change_impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["impact_id", "change_id", "capability_id", "affected_capability_ids", "classification", "knowledge_state", "confidence", "rationale", "evidence_refs", "truth_boundary"],
        "properties": {
          "impact_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "change_id": {"type": "string", "minLength": 2},
          "capability_id": {"type": "string", "minLength": 2},
          "affected_capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "classification": {"enum": ["direct", "conditional", "supporting", "outside-runtime", "unknown"]},
          "knowledge_state": {"enum": ["inferred-knowledge", "unknown"]},
          "confidence": {"enum": ["medium", "not-applicable"]},
          "rationale": {"type": "string", "minLength": 12},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "truth_boundary": {"const": "prediction-not-architecture-fact"}
        },
        "allOf": [
          {
            "if": {"properties": {"classification": {"const": "unknown"}}},
            "then": {"properties": {"knowledge_state": {"const": "unknown"}, "confidence": {"const": "not-applicable"}}},
            "else": {"properties": {"knowledge_state": {"const": "inferred-knowledge"}, "confidence": {"const": "medium"}, "evidence_refs": {"minItems": 1}}}
          }
        ]
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 40}
  }
}
