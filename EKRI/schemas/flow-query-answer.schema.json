{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKRI P5 Flow Query Answer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "query_kind", "disclosure_level", "authority_mode", "source", "resolution", "answer", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "ekri.flow-query-answer.v1"},
    "status": {"const": "flow-query-answered"},
    "query_kind": {"const": "trace-flow"},
    "disclosure_level": {"enum": ["L0", "L1", "L2", "L3"]},
    "authority_mode": {"const": "derived-non-authoritative"},
    "source": {"$ref": "#/$defs/source"},
    "resolution": {"$ref": "#/$defs/resolution"},
    "answer": {"type": "object"},
    "claim_ceiling": {"type": "string", "minLength": 80}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "profile_id", "context_id", "context_semantic_identity", "semantic_fingerprint", "projection_fingerprint"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 2},
        "profile_id": {"type": "string", "minLength": 2},
        "context_id": {"type": "string", "minLength": 2},
        "context_semantic_identity": {"type": "string", "minLength": 2},
        "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "projection_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "flow_definition_ref", "entry_occurrence_ids"],
      "properties": {
        "status": {"const": "matched"},
        "flow_definition_ref": {"type": "string", "minLength": 2},
        "entry_occurrence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}}
      }
    }
  }
}
