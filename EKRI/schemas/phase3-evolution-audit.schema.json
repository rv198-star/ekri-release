{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKRI Phase 3 Evolution Audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "status", "created_at", "source_tree", "bindings", "output_digests", "checks", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "ekri.phase3-evolution-audit.v1"},
    "phase": {"const": "phase3-evolution-and-impact-intelligence"},
    "status": {"const": "phase3-output-audit-complete"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_id", "baseline_manifest_sha256", "target_manifest_sha256", "evolution_map_sha256", "impact_map_sha256", "snapshot_refresh_sha256"],
      "properties": {
        "scan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evolution_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "impact_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot_refresh_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "output_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incremental-reconstruction.json", "change-register.json", "architecture-evolution-map.json", "change-impact-map.json", "architecture-snapshot-refresh.json", "PHASE3_EVOLUTION.md"],
      "properties": {
        "incremental-reconstruction.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "change-register.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "architecture-evolution-map.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "change-impact-map.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "architecture-snapshot-refresh.json": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "PHASE3_EVOLUTION.md": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "detail"],
        "properties": {
          "check": {"type": "string", "minLength": 2},
          "status": {"const": "passed"},
          "detail": {"type": "string", "minLength": 8}
        }
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 40}
  }
}
