{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKRI Project Knowledge Asset v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "asset_id",
    "profile_id",
    "producer",
    "knowledge_model",
    "target",
    "identity",
    "portability",
    "families",
    "derived_surfaces",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {"const": "ekri.project-knowledge-asset.v2"},
    "status": {"const": "portable-project-knowledge-partial-ready"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "profile_id": {"type": "string", "minLength": 3},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "product_version", "release_tag", "source_revision", "source_tree"],
      "properties": {
        "product": {"const": "EKRI"},
        "product_version": {"type": "string", "minLength": 3},
        "release_tag": {"type": "string", "pattern": "^ekri/v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
      }
    },
    "knowledge_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_path", "contract_sha256"],
      "properties": {
        "contract_id": {"const": "ekri.engineering-knowledge-model.v1"},
        "contract_path": {"const": "EKRI/docs/v100-supported-product-contract-v1.0.md"},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "product_version", "ref", "commit", "tree", "accepted_path_count", "admitted_path_set_sha256"],
      "properties": {
        "product": {"type": "string", "minLength": 2},
        "product_version": {"type": "string", "minLength": 2},
        "ref": {"type": "string", "minLength": 2},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "accepted_path_count": {"type": "integer", "minimum": 1},
        "admitted_path_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_asset_namespace", "namespace_policy"],
      "properties": {
        "repository_asset_namespace": {"type": "string", "minLength": 2},
        "namespace_policy": {"const": "stable-across-target-patch-and-producer-version"}
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_root_token", "formal_corpus_exclusions", "explicit_asset_selection_required"],
      "properties": {
        "repository_root_token": {"const": "${REPOSITORY_ROOT}"},
        "formal_corpus_exclusions": {"const": ["EKRI/", ".EKRI/"]},
        "explicit_asset_selection_required": {"const": true}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "availability",
          "authority_posture",
          "compatibility_posture",
          "scope",
          "source_contract",
          "artifact",
          "claim_ceiling"
        ],
        "properties": {
          "family_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
          "availability": {
            "enum": [
              "native-bounded",
              "bounded-overlay",
              "migration-supported-legacy",
              "blocked-source-contract-drift",
              "derived-conformance"
            ]
          },
          "authority_posture": {"type": "string", "minLength": 8},
          "compatibility_posture": {"type": "string", "minLength": 8},
          "scope": {"type": "string", "minLength": 8},
          "source_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contract_id", "path", "sha256", "source_revision"],
            "properties": {
              "contract_id": {"type": "string", "minLength": 3},
              "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "role"],
            "properties": {
              "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "role": {"enum": ["bounded-portable-projection", "evidence-only", "migration-evidence", "conformance-evidence"]}
            }
          },
          "claim_ceiling": {"type": "string", "minLength": 40}
        }
      }
    },
    "derived_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "posture", "promoted_as_truth"],
        "properties": {
          "surface_id": {"type": "string", "minLength": 3},
          "posture": {"enum": ["rebuildable-derived", "conformance-only"]},
          "promoted_as_truth": {"const": false},
          "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "claim_ceiling": {"type": "string", "minLength": 80}
  }
}
